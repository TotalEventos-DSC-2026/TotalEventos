{
  "name": "totaleventos",
  "version": "1.0.0",
  "private": true,
  "description": "API do projeto TotalEventos em TypeScript",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:show": "npm run build && typeorm-ts-node-commonjs -d dist/src/database/data-source.js migration:show",
    "migration:run": "npm run build && typeorm-ts-node-commonjs -d dist/src/database/data-source.js migration:run",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  }
}
